#!/usr/bin/env python3
"""Generate the share-card copies of s.html and their Netlify rewrites.

A shared Fotospots link carries c=1..10 (and l=de for German senders) so that apps reading
og:image show one of ten branded cards instead of the app icon. Each card gets its own copy of
s.html that differs only in the preview image tags, and netlify.toml routes /s/* and /share/*
to that copy by query parameter. Links without c keep s.html. The page stays spot-blind: the
query only picks a static file, nothing reads it.

The cards themselves are final files from the app repo (docs/product/share-cards/cards) and are
copied into assets/share-cards unchanged.

Usage:
    scripts/gen-share-card-pages          rewrite the pages and the netlify.toml block
    scripts/gen-share-card-pages --check  fail if either is out of date with s.html
"""

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CARDS = range(1, 11)
LOCALES = ("de", "en")          # German first: Netlify takes the first rule that matches
IMAGE_BASE = "https://photospots.net/assets/share-cards"
BEGIN = "# --- BEGIN share cards (generated by scripts/gen-share-card-pages) ---"
END = "# --- END share cards ---"


def page(source, n, locale):
    image = f"{IMAGE_BASE}/card-{n}-{locale}.jpg"
    og = (f'<meta property="og:image" content="{image}">\n'
          f'    <meta property="og:image:width" content="1200">\n'
          f'    <meta property="og:image:height" content="630">\n'
          f'    <meta property="og:image:type" content="image/jpeg">')
    out, count = re.subn(r'<meta property="og:image" content="[^"]*">', og, source)
    out, count2 = re.subn(r'<meta name="twitter:image" content="[^"]*">',
                          f'<meta name="twitter:image" content="{image}">', out)
    if count != 1 or count2 != 1:
        sys.exit("gen-share-card-pages: s.html must carry exactly one og:image and one twitter:image")
    return out


def rules():
    lines = [BEGIN,
             "#",
             "# One rewrite per card and language, for each share path. The app appends c and l;",
             "# these only choose which static copy of s.html is served, so the preview image",
             "# changes and the visible page does not.",
             ""]
    for prefix in ("s", "share"):
        for n in CARDS:
            for locale in LOCALES:
                query = f'{{ c = "{n}", l = "de" }}' if locale == "de" else f'{{ c = "{n}" }}'
                lines += ["[[redirects]]",
                          f'  from = "/{prefix}/*"',
                          f'  to = "/s-card-{n}-{locale}.html"',
                          "  status = 200",
                          f"  query = {query}",
                          ""]
    lines.append(END)
    return "\n".join(lines)


def netlify(current):
    block = rules()
    if BEGIN in current:
        start, stop = current.index(BEGIN), current.index(END) + len(END)
        return current[:start] + block + current[stop:]
    anchor = '[[redirects]]\n  from = "/s/*"\n  to = "/s.html"'
    if anchor not in current:
        sys.exit("gen-share-card-pages: cannot find the /s/* rule in netlify.toml")
    return current.replace(anchor, block + "\n\n" + anchor, 1)


def main():
    check = "--check" in sys.argv
    source = (ROOT / "s.html").read_text()
    wanted = {ROOT / f"s-card-{n}-{locale}.html": page(source, n, locale) for n in CARDS for locale in LOCALES}
    toml = ROOT / "netlify.toml"
    wanted[toml] = netlify(toml.read_text())
    stale = [p for p, text in wanted.items() if not p.exists() or p.read_text() != text]
    missing = [f"assets/share-cards/card-{n}-{l}.jpg" for n in CARDS for l in LOCALES
               if not (ROOT / "assets" / "share-cards" / f"card-{n}-{l}.jpg").exists()]
    if check:
        for p in stale:
            print(f"gen-share-card-pages: out of date: {p.relative_to(ROOT)}")
        for m in missing:
            print(f"gen-share-card-pages: missing: {m}")
        sys.exit(1 if stale or missing else 0)
    for p in stale:
        p.write_text(wanted[p])
    for m in missing:
        print(f"gen-share-card-pages: missing: {m}")
    print(f"gen-share-card-pages: wrote {len(stale)} file(s)")


if __name__ == "__main__":
    main()
